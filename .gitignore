# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Experiment outputs (regenerable; keep the repo lean). Checked-in source
# data (e.g. data/handwritten/) is tracked by default — ignore generated
# OUTPUT locations wholesale instead of blanket-ignoring by extension, so
# new curated data files never need a negation rule to be seen by git.
data/results*/
data/directions*/
data/calibration*.json
data/stimuli/*.jsonl
figures*/

# Tooling
.pytest_cache/
.ruff_cache/
.DS_Store

PROJECT_MAP.md